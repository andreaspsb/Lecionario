{
  "name": "lecionario-web",
  "type": "module",
  "version": "0.1.0",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build && pagefind --site dist --output-path dist/pagefind",
    "preview": "astro preview",
    "test": "node --import ./scripts/node_modules/tsx/dist/loader.mjs tests/run.ts",
    "typecheck": "tsc --noEmit",
    "validate": "npm run test && npm run typecheck && npm --prefix scripts run test && npm --prefix scripts run typecheck && npm run build",
    "astro": "astro"
  },
  "dependencies": {
    "@tailwindcss/typography": "^0.5.20",
    "@tailwindcss/vite": "^4.3.2",
    "astro": "^7.0.4",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "pagefind": "^1.5.2",
    "typescript": "^6.0.3"
  }
}
