---
import Base from '../layouts/Base.astro';
import { nomeEstacao, corLiturgica } from '../lib/liturgicalCalendar';

// Importamos os dados estruturais dos scripts
// Astro resolve .ts diretamente, sem precisar de .js
import { anoA } from '../../scripts/src/data/year-a';
import { anoB } from '../../scripts/src/data/year-b';
import { anoC } from '../../scripts/src/data/year-c';

const anos = [anoA, anoB, anoC];

const tipoBadge: Record<string, string> = {
  domingo: '◉',
  festa: '✦',
  'dia-festo': '✦',
  ferial: '·',
};

const base = import.meta.env.BASE_URL;

const corBadgeClasses: Record<string, string> = {
  purple: 'text-purple-400',
  white: 'text-blue-300',
  red: 'text-red-400',
  green: 'text-green-400',
  gray: 'text-gray-400',
};
---

<Base title="Navegar — Lecionário">
  <section class="mb-10">
    <h1 class="text-2xl font-bold text-white mb-2">Índice Completo</h1>
    <p class="text-gray-400 text-sm">Todas as leituras organizadas por Ano Litúrgico e Estação</p>
  </section>

  {anos.map((dadosAno) => (
    <section id={`ano-${dadosAno.ano.toLowerCase()}`} class="mb-14">
      <div class="flex items-center gap-3 mb-6">
        <h2 class="text-xl font-bold text-white">Ano {dadosAno.ano}</h2>
        <span class="text-sm text-gray-500">
          {dadosAno.ano === 'A' ? 'Evangelho de Mateus' : dadosAno.ano === 'B' ? 'Evangelho de Marcos' : 'Evangelho de Lucas'}
        </span>
      </div>

      {dadosAno.estacoes.map((estacao) => {
        const cor = corLiturgica(estacao.id);
        const borderColor = corBadgeClasses[cor] ?? corBadgeClasses.gray;
        return (
          <div class="mb-8">
            <h3 class={`text-sm font-semibold uppercase tracking-widest mb-3 ${borderColor}`}>
              {nomeEstacao(estacao.id)}
            </h3>
            <ul class="space-y-1">
              {estacao.dias.map((dia) => {
                const slug = dia.arquivo.replace(/\.md$/, '');
                const icone = tipoBadge[dia.tipo] ?? '·';
                return (
                  <li>
                    <a
                      href={`${base}/leitura/${slug}`}
                      class="flex items-center gap-3 px-3 py-2 rounded-lg hover:bg-gray-800/60 transition-colors group"
                    >
                      <span class={`text-xs w-4 shrink-0 ${borderColor} opacity-60`}>{icone}</span>
                      <span class="text-sm text-gray-300 group-hover:text-white transition-colors">
                        {dia.nome}
                      </span>
                    </a>
                  </li>
                );
              })}
            </ul>
          </div>
        );
      })}
    </section>
  ))}
</Base>
