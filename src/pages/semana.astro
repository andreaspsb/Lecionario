---
import Base from '../layouts/Base.astro';
import LiturgicalWeekTimeline from '../components/LiturgicalWeekTimeline.astro';
import { getCollection } from 'astro:content';
import { formatarData, nomeEstacao } from '../lib/liturgicalCalendar';
import { getReadingForDate } from '../lib/dateNavigation';
import { parseSumarioLinks } from '../lib/sumarioParser';
import {
  buildLiturgicalWeeks,
  findLiturgicalWeekForSlug,
  type LiturgicalWeekEntry,
} from '../lib/liturgicalWeek';

const hoje = new Date();
const leituraAtual = getReadingForDate(hoje);
const entries = await getCollection('leituras');
const order = parseSumarioLinks().map((link) => link.slug);
const base = import.meta.env.BASE_URL;

const items: LiturgicalWeekEntry[] = entries.map((entry) => ({
  slug: entry.id,
  title: entry.data.titulo ?? entry.data.nome ?? 'Leitura',
  ano: entry.data.ano,
  estacao: entry.data.estacao,
  tipo: entry.data.tipo,
}));

const weeks = buildLiturgicalWeeks(items, order);
const currentWeek = leituraAtual ? findLiturgicalWeekForSlug(weeks, leituraAtual.slug) : null;
const currentIndex = currentWeek ? weeks.findIndex((week) => week.anchor.slug === currentWeek.anchor.slug) : -1;
const previousWeek = currentIndex > 0 ? weeks[currentIndex - 1] : null;
const nextWeek = currentIndex >= 0 && currentIndex < weeks.length - 1 ? weeks[currentIndex + 1] : null;
---

<Base title="Semana litúrgica" description="Semana litúrgica atual do Lecionário Comum Revisado">
  <section class="mb-8">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Quinta a quarta</p>
    <h1 class="text-3xl font-bold text-gray-100">Semana litúrgica</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-400">
      {formatarData(hoje)}
    </p>
  </section>

  {currentWeek ? (
    <>
      <section class="mb-8 rounded-xl border border-gray-800 bg-gray-900/40 p-5">
        <div class="flex flex-wrap items-start justify-between gap-4">
          <div>
            <p class="text-xs font-medium uppercase tracking-wider text-gray-500">
              Ano {currentWeek.ano} · {nomeEstacao(currentWeek.seasonKey)}
            </p>
            <h2 class="mt-2 text-xl font-semibold text-gray-100">
              Semana de {currentWeek.anchor.title}
            </h2>
          </div>
          {leituraAtual && (
            <a href={`${base}/leitura/${leituraAtual.slug}`} class="rounded-lg border border-blue-800 bg-blue-950/30 px-3 py-2 text-sm text-blue-200 hover:bg-blue-950/50">
              Leitura de hoje
            </a>
          )}
        </div>
      </section>

      <section class="mb-8">
        <LiturgicalWeekTimeline week={currentWeek} base={base} currentSlug={leituraAtual?.slug} />
      </section>

      <nav data-pagefind-ignore class="grid gap-3 sm:grid-cols-2">
        {previousWeek ? (
          <a href={`${base}/leitura/${previousWeek.anchor.slug}`} class="rounded-xl border border-gray-800 bg-gray-900/30 p-4 hover:bg-gray-800/50">
            <p class="text-xs text-gray-500">Semana anterior</p>
            <p class="mt-1 text-sm font-medium text-gray-200">{previousWeek.anchor.title}</p>
          </a>
        ) : (
          <div class="rounded-xl border border-gray-900 bg-gray-950/40 p-4 text-sm text-gray-600">Sem semana anterior.</div>
        )}

        {nextWeek ? (
          <a href={`${base}/leitura/${nextWeek.anchor.slug}`} class="rounded-xl border border-gray-800 bg-gray-900/30 p-4 text-right hover:bg-gray-800/50">
            <p class="text-xs text-gray-500">Próxima semana</p>
            <p class="mt-1 text-sm font-medium text-gray-200">{nextWeek.anchor.title}</p>
          </a>
        ) : (
          <div class="rounded-xl border border-gray-900 bg-gray-950/40 p-4 text-right text-sm text-gray-600">Sem próxima semana.</div>
        )}
      </nav>
    </>
  ) : (
    <section class="rounded-xl border border-gray-800 bg-gray-900/40 p-6 text-gray-400">
      Não foi possível identificar a semana litúrgica atual.
    </section>
  )}
</Base>
