---
import Base from '../layouts/Base.astro';
const base = import.meta.env.BASE_URL;
---

<Base title="Buscar" description="Busca full-text no Lecionário Comum Revisado ">
  <div data-pagefind-ignore>
    <div class="mb-8">
      <h1 class="text-3xl font-bold text-gray-100 mb-2">Buscar</h1>
      <p class="text-gray-400 text-sm">Pesquise por passagem bíblica, estação litúrgica ou título</p>
    </div>

    <div id="search" class="mb-10"></div>
  </div>
</Base>

<link href={`${base}/pagefind/pagefind-ui.css`} rel="stylesheet" />
<script src={`${base}/pagefind/pagefind-ui.js`} is:inline></script>
<script define:vars={{ base }}>
  window.addEventListener('DOMContentLoaded', () => {
    new PagefindUI({
      element: '#search',
      baseUrl: base,
      bundlePath: `${base}/pagefind/`,
      showImages: false,
      translations: {
        placeholder: 'Ex: Isaías, Advento, Romanos…',
        zero_results: 'Nenhum resultado para "[SEARCH_TERM]"',
        many_results: '[COUNT] resultados para "[SEARCH_TERM]"',
        one_result: '1 resultado para "[SEARCH_TERM]"',
        load_more: 'Carregar mais resultados',
        search_label: 'Buscar no lecionário',
        filters_label: 'Filtros',
        clear_search: 'Limpar',
        clear_filters: 'Limpar filtros',
        search_loading: 'Buscando…',
      },
    });
  });
</script>

<style is:global>
  /* Integração com tema dark */
  :root {
    --pagefind-ui-scale: 1;
    --pagefind-ui-primary: #818cf8;
    --pagefind-ui-text: #e5e7eb;
    --pagefind-ui-background: #111827;
    --pagefind-ui-border: #374151;
    --pagefind-ui-tag: #1f2937;
    --pagefind-ui-border-width: 1px;
    --pagefind-ui-border-radius: 8px;
    --pagefind-ui-image-border-radius: 4px;
    --pagefind-ui-image-box-ratio: 3 / 2;
    --pagefind-ui-font: inherit;
  }

  .pagefind-ui__search-input {
    background-color: #1f2937 !important;
    color: #f9fafb !important;
    border-color: #374151 !important;
  }

  .pagefind-ui__search-input::placeholder {
    color: #6b7280 !important;
  }

  .pagefind-ui__result {
    border-color: #1f2937 !important;
    padding: 1rem 0 !important;
  }

  .pagefind-ui__result-title a {
    color: #a5b4fc !important;
    font-weight: 600 !important;
  }

  .pagefind-ui__result-excerpt {
    color: #9ca3af !important;
    font-size: 0.875rem !important;
  }

  .pagefind-ui__result-excerpt mark {
    background: transparent !important;
    color: #f9fafb !important;
    font-weight: 600 !important;
  }

  .pagefind-ui__button {
    background-color: #1f2937 !important;
    border-color: #374151 !important;
    color: #d1d5db !important;
  }

  .pagefind-ui__button:hover {
    background-color: #374151 !important;
  }

  .pagefind-ui__search-clear {
    color: #9ca3af !important;
  }

  .pagefind-ui__message {
    color: #6b7280 !important;
    font-size: 0.875rem !important;
  }
</style>
