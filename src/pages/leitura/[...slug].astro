---
import { getCollection, render } from 'astro:content';
import fs from 'node:fs';
import path from 'node:path';
import Base from '../../layouts/Base.astro';
import { nomeEstacao, corLiturgica } from '../../lib/liturgicalCalendar';
import { parseSumarioLinks, type SumarioLink } from '../../lib/sumarioParser';
import { buildReadingExport } from '../../lib/readingExport';

export async function getStaticPaths() {
  const entries = await getCollection('leituras');
  const links = parseSumarioLinks();
  const entryIds = new Set(entries.map((entry) => entry.id));
  const indexBySlug = new Map(links.map((item, idx) => [item.slug, idx]));

  const findPrevious = (idx: number): SumarioLink | null => {
    for (let i = idx - 1; i >= 0; i--) {
      const candidate = links[i];
      if (entryIds.has(candidate.slug)) {
        return candidate;
      }
    }
    return null;
  };

  const findNext = (idx: number): SumarioLink | null => {
    for (let i = idx + 1; i < links.length; i++) {
      const candidate = links[i];
      if (entryIds.has(candidate.slug)) {
        return candidate;
      }
    }
    return null;
  };

  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: {
      entry,
      prev: indexBySlug.has(entry.id) ? findPrevious(indexBySlug.get(entry.id) ?? -1) : null,
      next: indexBySlug.has(entry.id) ? findNext(indexBySlug.get(entry.id) ?? -1) : null,
    },
  }));
}

const { entry, prev, next } = Astro.props as {
  entry: (Awaited<ReturnType<typeof getCollection>>)[number];
  prev: SumarioLink | null;
  next: SumarioLink | null;
};
const { Content } = await render(entry);

const { titulo, nome, ano, estacao, tipo } = entry.data;
const tituloDisplay = titulo ?? nome ?? 'Leitura Litúrgica';
const cor = corLiturgica(estacao?.toLowerCase() ?? '');
const projectRoot = process.env.INIT_CWD
  ?? (path.basename(process.cwd()) === 'dist' ? path.dirname(process.cwd()) : process.cwd());
const sourceMarkdown = fs.readFileSync(path.resolve(projectRoot, `${entry.id}.md`), 'utf-8');
const base = import.meta.env.BASE_URL;
const basePath = base.replace(/\/$/, '');
const readingUrl = new URL(`${basePath}/leitura/${entry.id}`, Astro.site).toString();
const exportData = buildReadingExport({
  title: tituloDisplay,
  ano,
  estacao,
  tipo,
  markdown: sourceMarkdown,
  url: readingUrl,
  slug: entry.id,
});
const exportJson = JSON.stringify(exportData).replace(/</g, '\\u003c');

const corHeaderClasses: Record<string, string> = {
  purple: 'from-purple-950/50 to-transparent border-purple-800/40',
  white: 'from-blue-950/50 to-transparent border-blue-800/40',
  red: 'from-red-950/50 to-transparent border-red-800/40',
  green: 'from-green-950/50 to-transparent border-green-800/40',
  gray: 'from-gray-900/50 to-transparent border-gray-800/40',
};

const corBadgeClasses: Record<string, string> = {
  purple: 'bg-purple-900/40 text-purple-300',
  white: 'bg-blue-900/40 text-blue-300',
  red: 'bg-red-900/40 text-red-300',
  green: 'bg-green-900/40 text-green-300',
  gray: 'bg-gray-800 text-gray-300',
};

---

<Base title={tituloDisplay}>
  <nav class="mb-5 text-xs text-gray-500" aria-label="Breadcrumb">
    <ol class="flex flex-wrap items-center gap-1.5">
      <li>
        <a href={base} class="hover:text-gray-300 transition-colors">Lecionário</a>
      </li>
      <li class="text-gray-700">/</li>
      <li>
        <a href={`${base}/navegar#ano-${String(ano).toLowerCase()}`} class="hover:text-gray-300 transition-colors">
          Ano {ano}
        </a>
      </li>
      <li class="text-gray-700">/</li>
      <li>{nomeEstacao(estacao?.toLowerCase() ?? estacao)}</li>
      <li class="text-gray-700">/</li>
      <li class="text-gray-300">{tituloDisplay}</li>
    </ol>
  </nav>

  <!-- Cabeçalho com cor litúrgica -->
  <div class={`rounded-2xl border bg-gradient-to-b p-6 mb-8 ${corHeaderClasses[cor] ?? corHeaderClasses.gray}`}>
    <div class="flex flex-wrap items-center gap-2 mb-3">
      <span class={`text-xs font-medium px-2.5 py-1 rounded-full ${corBadgeClasses[cor] ?? corBadgeClasses.gray}`}>
        {nomeEstacao(estacao?.toLowerCase() ?? estacao)}
      </span>
      <span class="text-xs text-gray-500">Ano {ano}</span>
      <span class="text-xs text-gray-600">·</span>
      <span class="text-xs text-gray-500">{tipo}</span>
    </div>
    <h1 data-pagefind-meta="title" class="text-2xl font-bold text-white leading-tight">{tituloDisplay}</h1>
  </div>

  <section data-pagefind-ignore class="mb-8 rounded-xl border border-gray-800 bg-gray-900/40 p-4">
    <div class="flex flex-wrap items-center gap-2">
      <button
        type="button"
        data-export-action="copy-markdown"
        class="rounded-md border border-gray-700 px-3 py-2 text-sm font-medium text-gray-200 transition-colors hover:border-gray-500 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Copiar texto
      </button>
      <button
        type="button"
        data-export-action="download-markdown"
        class="rounded-md border border-gray-700 px-3 py-2 text-sm font-medium text-gray-200 transition-colors hover:border-gray-500 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Baixar .md
      </button>
      <button
        type="button"
        data-export-action="download-html"
        class="rounded-md border border-gray-700 px-3 py-2 text-sm font-medium text-gray-200 transition-colors hover:border-gray-500 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Baixar HTML
      </button>
      <button
        type="button"
        data-export-action="copy-link"
        class="rounded-md border border-gray-700 px-3 py-2 text-sm font-medium text-gray-200 transition-colors hover:border-gray-500 hover:bg-gray-800 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Copiar link
      </button>
      <button
        type="button"
        data-export-action="share"
        class="rounded-md border border-blue-800 bg-blue-950/30 px-3 py-2 text-sm font-medium text-blue-200 transition-colors hover:border-blue-600 hover:bg-blue-900/40 focus:outline-none focus:ring-2 focus:ring-blue-500"
      >
        Compartilhar
      </button>
    </div>
    <p data-export-status class="mt-3 min-h-5 text-sm text-gray-500" aria-live="polite"></p>
  </section>

  <script type="application/json" data-reading-export set:html={exportJson} />

  <!-- Conteúdo do arquivo .md renderizado -->
  <div data-pagefind-body class="prose prose-invert prose-sm max-w-none
    prose-headings:font-semibold prose-headings:text-gray-100
    prose-h2:text-lg prose-h2:mt-8 prose-h2:mb-3
    prose-p:text-gray-300 prose-p:leading-relaxed
    prose-table:w-full prose-table:border-collapse
    prose-td:border prose-td:border-gray-800 prose-td:px-3 prose-td:py-2 prose-td:text-sm
    prose-th:border prose-th:border-gray-800 prose-th:px-3 prose-th:py-2 prose-th:text-sm
    prose-strong:text-gray-200
    prose-hr:border-gray-800
    prose-a:text-blue-400 prose-a:no-underline hover:prose-a:underline
    prose-blockquote:border-l-gray-700 prose-blockquote:text-gray-400
    prose-code:text-gray-300 prose-code:bg-gray-800 prose-code:px-1 prose-code:rounded
    prose-em:text-gray-400">
    <Content />
  </div>

  <!-- Navegação -->
  <div class="mt-12 pt-6 border-t border-gray-800 flex flex-wrap items-center justify-between gap-3">
    <div class="flex-1 min-w-[220px]">
      {prev ? (
        <a
          href={`${base}/leitura/${prev.slug}`}
          class="inline-flex max-w-full items-center gap-2 text-sm text-gray-400 hover:text-gray-100 transition-colors"
        >
          <span aria-hidden="true">←</span>
          <span class="truncate">{prev.nome}</span>
        </a>
      ) : (
        <span class="text-sm text-gray-600">Início do lecionário</span>
      )}
    </div>

    <div class="flex items-center gap-4">
      <a
        href={`${base}/hoje`}
        class="inline-flex items-center gap-2 text-sm text-gray-300 hover:text-white transition-colors"
      >
        ✦ Hoje
      </a>
      <a
        href={`${base}/navegar`}
        class="inline-flex items-center gap-2 text-sm text-gray-400 hover:text-gray-100 transition-colors"
      >
        Índice
      </a>
    </div>

    <div class="flex-1 min-w-[220px] text-right">
      {next ? (
        <a
          href={`${base}/leitura/${next.slug}`}
          class="inline-flex max-w-full items-center gap-2 text-sm text-gray-400 hover:text-gray-100 transition-colors"
        >
          <span class="truncate">{next.nome}</span>
          <span aria-hidden="true">→</span>
        </a>
      ) : (
        <span class="text-sm text-gray-600">Fim do lecionário</span>
      )}
    </div>
  </div>
</Base>

<script>
  interface ReadingExportPayload {
    filenameBase: string;
    markdown: string;
    html: string;
    shareText: string;
  }

  const payloadElement = document.querySelector('[data-reading-export]');
  const statusElement = document.querySelector('[data-export-status]');
  const payload = payloadElement?.textContent
    ? JSON.parse(payloadElement.textContent) as ReadingExportPayload
    : null;

  const setExportStatus = (message: string) => {
    if (statusElement) {
      statusElement.textContent = message;
    }
  };

  const copyText = async (text: string) => {
    if (navigator.clipboard) {
      await navigator.clipboard.writeText(text);
      return;
    }

    const textarea = document.createElement('textarea');
    textarea.value = text;
    textarea.setAttribute('readonly', '');
    textarea.style.position = 'fixed';
    textarea.style.opacity = '0';
    document.body.appendChild(textarea);
    textarea.select();
    document.execCommand('copy');
    textarea.remove();
  };

  const downloadText = (content: string, filename: string, type: string) => {
    const blob = new Blob([content], { type });
    const url = URL.createObjectURL(blob);
    const anchor = document.createElement('a');
    anchor.href = url;
    anchor.download = filename;
    document.body.appendChild(anchor);
    anchor.click();
    anchor.remove();
    URL.revokeObjectURL(url);
  };

  document.querySelectorAll('[data-export-action]').forEach((button) => {
    button.addEventListener('click', async () => {
      if (!payload || !(button instanceof HTMLElement)) return;

      const action = button.dataset.exportAction;
      try {
        if (action === 'copy-markdown') {
          await copyText(payload.markdown);
          setExportStatus('Texto da leitura copiado.');
        } else if (action === 'download-markdown') {
          downloadText(payload.markdown, `${payload.filenameBase}.md`, 'text/markdown;charset=utf-8');
          setExportStatus('Arquivo Markdown gerado.');
        } else if (action === 'download-html') {
          downloadText(payload.html, `${payload.filenameBase}.html`, 'text/html;charset=utf-8');
          setExportStatus('Arquivo HTML gerado.');
        } else if (action === 'copy-link') {
          await copyText(payload.shareText);
          setExportStatus('Link e resumo copiados.');
        } else if (action === 'share') {
          if (navigator.share) {
            await navigator.share({ text: payload.shareText });
            setExportStatus('Compartilhamento aberto.');
          } else {
            await copyText(payload.shareText);
            setExportStatus('Compartilhamento copiado.');
          }
        }
      } catch {
        setExportStatus('Não foi possível concluir a ação.');
      }
    });
  });
</script>
