---
import fs from 'node:fs';
import path from 'node:path';
import { getCollection } from 'astro:content';
import Base from '../layouts/Base.astro';
import { nomeEstacao } from '../lib/liturgicalCalendar';
import {
  analyzeDevotionalSource,
  buildDevotionalReport,
  type DevotionalFileStatus,
  type DevotionalStatus,
} from '../lib/devotionalStatus';

const entries = await getCollection('leituras');
const projectRoot = process.env.INIT_CWD
  ?? (path.basename(process.cwd()) === 'dist' ? path.dirname(process.cwd()) : process.cwd());
const base = import.meta.env.BASE_URL;

const files = entries.map((entry) => {
  const markdown = fs.readFileSync(path.resolve(projectRoot, `${entry.id}.md`), 'utf-8');
  return analyzeDevotionalSource({
    slug: entry.id,
    title: entry.data.titulo ?? entry.data.nome ?? entry.id,
    ano: entry.data.ano,
    estacao: entry.data.estacao,
    tipo: entry.data.tipo,
    markdown,
  });
});

const report = buildDevotionalReport(files);
const sortedFiles = report.files
  .sort((a, b) => statusOrder(a.status) - statusOrder(b.status) || a.slug.localeCompare(b.slug));
const anos = Array.from(new Set(report.files.map((file) => file.ano))).sort();
const estacoes = Array.from(new Set(report.files.map((file) => file.estacao))).sort((a, b) => (
  nomeEstacao(a.toLowerCase()).localeCompare(nomeEstacao(b.toLowerCase()))
));

function statusOrder(status: DevotionalStatus): number {
  if (status === 'missing-section') return 0;
  if (status === 'placeholder') return 1;
  return 2;
}

function statusLabel(status: DevotionalStatus): string {
  if (status === 'missing-section') return 'Sem seção';
  if (status === 'placeholder') return 'Placeholder';
  return 'Preenchido';
}

function statusClass(status: DevotionalStatus): string {
  if (status === 'missing-section') return 'border-red-800 bg-red-950/30 text-red-200';
  if (status === 'placeholder') return 'border-amber-800 bg-amber-950/30 text-amber-200';
  return 'border-emerald-800 bg-emerald-950/30 text-emerald-200';
}
---

<Base title="Status dos devocionais" description="Relatório editorial de reflexões e devocionais">
  <section class="mb-8">
    <p class="mb-2 text-xs font-semibold uppercase tracking-[0.2em] text-gray-500">Relatório interno</p>
    <h1 class="text-3xl font-bold text-gray-100">Status dos devocionais</h1>
    <p class="mt-3 max-w-2xl text-sm leading-relaxed text-gray-400">
      Acompanhamento das seções <code class="rounded bg-gray-900 px-1.5 py-0.5 text-gray-300">## Reflexão</code>
      nos arquivos Markdown do lecionário.
    </p>
  </section>

  <section class="mb-8 grid gap-3 sm:grid-cols-2 lg:grid-cols-4">
    <div class="rounded-xl border border-gray-800 bg-gray-900/40 p-4">
      <p class="text-xs uppercase tracking-wider text-gray-500">Total</p>
      <p class="mt-2 text-3xl font-semibold text-gray-100">{report.total}</p>
    </div>
    <div class="rounded-xl border border-emerald-800 bg-emerald-950/20 p-4">
      <p class="text-xs uppercase tracking-wider text-emerald-300/70">Preenchidos</p>
      <p class="mt-2 text-3xl font-semibold text-emerald-100">{report.filledCount}</p>
    </div>
    <div class="rounded-xl border border-amber-800 bg-amber-950/20 p-4">
      <p class="text-xs uppercase tracking-wider text-amber-300/70">Com placeholder</p>
      <p class="mt-2 text-3xl font-semibold text-amber-100">{report.placeholderCount}</p>
    </div>
    <div class="rounded-xl border border-red-800 bg-red-950/20 p-4">
      <p class="text-xs uppercase tracking-wider text-red-300/70">Sem seção</p>
      <p class="mt-2 text-3xl font-semibold text-red-100">{report.missingSectionCount}</p>
    </div>
  </section>

  <section class="mb-10 rounded-xl border border-gray-800 bg-gray-900/40 p-5">
    <div class="mb-3 flex items-center justify-between gap-4">
      <h2 class="text-lg font-semibold text-gray-100">Progresso geral</h2>
      <span class="text-sm font-medium text-gray-300">{report.completionPercent}%</span>
    </div>
    <div class="h-3 overflow-hidden rounded-full bg-gray-800">
      <div class="h-full rounded-full bg-emerald-500" style={`width: ${report.completionPercent}%`}></div>
    </div>
  </section>

  <section class="mb-10">
    <h2 class="mb-4 text-lg font-semibold text-gray-100">Progresso por ano e estação</h2>
    <div class="overflow-x-auto rounded-xl border border-gray-800">
      <table class="w-full min-w-[720px] text-sm">
        <thead class="bg-gray-900/80 text-left text-xs uppercase tracking-wider text-gray-500">
          <tr>
            <th class="px-4 py-3">Ano</th>
            <th class="px-4 py-3">Estação</th>
            <th class="px-4 py-3 text-right">Total</th>
            <th class="px-4 py-3 text-right">Preenchidos</th>
            <th class="px-4 py-3 text-right">Placeholder</th>
            <th class="px-4 py-3 text-right">Sem seção</th>
            <th class="px-4 py-3">Progresso</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-gray-800">
          {report.byGroup.map((group) => (
            <tr class="bg-gray-950/20">
              <td class="px-4 py-3 font-medium text-gray-200">Ano {group.ano}</td>
              <td class="px-4 py-3 text-gray-300">{nomeEstacao(group.estacao.toLowerCase())}</td>
              <td class="px-4 py-3 text-right text-gray-300">{group.total}</td>
              <td class="px-4 py-3 text-right text-emerald-300">{group.filledCount}</td>
              <td class="px-4 py-3 text-right text-amber-300">{group.placeholderCount}</td>
              <td class="px-4 py-3 text-right text-red-300">{group.missingSectionCount}</td>
              <td class="px-4 py-3">
                <div class="flex items-center gap-3">
                  <div class="h-2 w-24 overflow-hidden rounded-full bg-gray-800">
                    <div class="h-full rounded-full bg-emerald-500" style={`width: ${group.completionPercent}%`}></div>
                  </div>
                  <span class="w-10 text-right text-xs text-gray-400">{group.completionPercent}%</span>
                </div>
              </td>
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </section>

  <section data-pagefind-ignore class="mb-6 rounded-xl border border-gray-800 bg-gray-900/40 p-4">
    <div class="grid gap-4 md:grid-cols-3">
      <label class="block">
        <span class="mb-2 block text-xs font-medium uppercase tracking-wider text-gray-500">Ano</span>
        <select data-devotional-filter="ano" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-gray-100 focus:border-blue-500 focus:outline-none">
          <option value="all">Todos</option>
          {anos.map((ano) => (
            <option value={ano}>Ano {ano}</option>
          ))}
        </select>
      </label>

      <label class="block">
        <span class="mb-2 block text-xs font-medium uppercase tracking-wider text-gray-500">Estação</span>
        <select data-devotional-filter="estacao" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-gray-100 focus:border-blue-500 focus:outline-none">
          <option value="all">Todas</option>
          {estacoes.map((estacao) => (
            <option value={estacao}>{nomeEstacao(estacao.toLowerCase())}</option>
          ))}
        </select>
      </label>

      <label class="block">
        <span class="mb-2 block text-xs font-medium uppercase tracking-wider text-gray-500">Status</span>
        <select data-devotional-filter="status" class="w-full rounded-lg border border-gray-700 bg-gray-950 px-3 py-2 text-sm text-gray-100 focus:border-blue-500 focus:outline-none">
          <option value="placeholder" selected>Com placeholder</option>
          <option value="filled">Preenchidos</option>
          <option value="missing-section">Sem seção</option>
          <option value="all">Todos</option>
        </select>
      </label>
    </div>

    <div class="mt-4 flex flex-wrap items-center justify-between gap-3">
      <p class="text-sm text-gray-400">
        <span data-devotional-count>{report.placeholderCount}</span> arquivos exibidos
      </p>
      <button type="button" data-devotional-reset class="text-sm text-blue-400 hover:underline">
        Voltar aos pendentes
      </button>
    </div>
  </section>

  <section>
    <div class="mb-4">
      <h2 class="text-lg font-semibold text-gray-100">Arquivos</h2>
      <p class="mt-1 text-sm text-gray-500">Use os filtros para priorizar a revisão editorial.</p>
    </div>

    <div class="divide-y divide-gray-800 rounded-xl border border-gray-800 bg-gray-900/30">
      {sortedFiles.map((file: DevotionalFileStatus) => (
        <a
          href={`${base}/leitura/${file.slug}`}
          data-devotional-item
          data-ano={file.ano}
          data-estacao={file.estacao}
          data-status={file.status}
          class={`flex flex-wrap items-center justify-between gap-3 px-4 py-3 transition-colors hover:bg-gray-800/50 ${file.status !== 'placeholder' ? 'hidden' : ''}`}
        >
          <div>
            <p class="text-sm font-medium text-gray-100">{file.title}</p>
            <p class="mt-1 text-xs text-gray-500">Ano {file.ano} · {file.estacao} · {file.tipo}</p>
          </div>
          <span class={`rounded-full border px-2.5 py-1 text-xs font-medium ${statusClass(file.status)}`}>
            {statusLabel(file.status)}
          </span>
        </a>
      ))}
    </div>
    <p data-devotional-empty class="mt-4 hidden rounded-xl border border-gray-800 bg-gray-900/30 p-4 text-sm text-gray-500">
      Nenhum arquivo corresponde aos filtros selecionados.
    </p>
  </section>
</Base>

<script>
  const controls = {
    ano: document.querySelector('[data-devotional-filter="ano"]'),
    estacao: document.querySelector('[data-devotional-filter="estacao"]'),
    status: document.querySelector('[data-devotional-filter="status"]'),
  };
  const items = Array.from(document.querySelectorAll('[data-devotional-item]'));
  const count = document.querySelector('[data-devotional-count]');
  const reset = document.querySelector('[data-devotional-reset]');
  const empty = document.querySelector('[data-devotional-empty]');

  const getFilterValue = (key: keyof typeof controls) => {
    const control = controls[key];
    return control instanceof HTMLSelectElement ? control.value : 'all';
  };

  const updateUrl = () => {
    const params = new URLSearchParams(window.location.search);
    for (const key of Object.keys(controls) as Array<keyof typeof controls>) {
      const value = getFilterValue(key);
      if (value === 'all' || (key === 'status' && value === 'placeholder')) {
        params.delete(key);
      } else {
        params.set(key, value);
      }
    }
    const query = params.toString();
    window.history.replaceState({}, '', `${window.location.pathname}${query ? `?${query}` : ''}`);
  };

  const applyDevotionalFilters = () => {
    const ano = getFilterValue('ano');
    const estacao = getFilterValue('estacao');
    const status = getFilterValue('status');
    let visibleCount = 0;

    for (const item of items) {
      if (!(item instanceof HTMLElement)) continue;
      const visible = (ano === 'all' || item.dataset.ano === ano)
        && (estacao === 'all' || item.dataset.estacao === estacao)
        && (status === 'all' || item.dataset.status === status);
      item.classList.toggle('hidden', !visible);
      if (visible) visibleCount++;
    }

    if (count) count.textContent = String(visibleCount);
    empty?.classList.toggle('hidden', visibleCount > 0);
    updateUrl();
  };

  const restoreDevotionalFilters = () => {
    const params = new URLSearchParams(window.location.search);
    for (const [key, control] of Object.entries(controls)) {
      if (control instanceof HTMLSelectElement) {
        control.value = params.get(key) ?? (key === 'status' ? 'placeholder' : 'all');
      }
    }
  };

  for (const control of Object.values(controls)) {
    control?.addEventListener('change', applyDevotionalFilters);
  }

  reset?.addEventListener('click', () => {
    for (const [key, control] of Object.entries(controls)) {
      if (control instanceof HTMLSelectElement) {
        control.value = key === 'status' ? 'placeholder' : 'all';
      }
    }
    applyDevotionalFilters();
  });

  restoreDevotionalFilters();
  applyDevotionalFilters();
</script>
