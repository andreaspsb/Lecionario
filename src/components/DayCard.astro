---
import type { DiaLiturgico } from '../lib/liturgicalCalendar';
import { nomeEstacao, corLiturgica } from '../lib/liturgicalCalendar';

interface Props {
  dia: DiaLiturgico;
  destaque?: boolean;
}

const { dia, destaque = false } = Astro.props;
const base = import.meta.env.BASE_URL;

const slug = dia.arquivo.replace(/\.md$/, '');
const cor = corLiturgica(dia.estacao);

const corClasses: Record<string, string> = {
  purple: 'border-purple-700 bg-purple-900/10',
  white: 'border-blue-700 bg-blue-900/10',
  red: 'border-red-700 bg-red-900/10',
  green: 'border-green-700 bg-green-900/10',
  gray: 'border-gray-700 bg-gray-800/10',
};

const badgeClasses: Record<string, string> = {
  purple: 'bg-purple-900/40 text-purple-300',
  white: 'bg-blue-900/40 text-blue-300',
  red: 'bg-red-900/40 text-red-300',
  green: 'bg-green-900/40 text-green-300',
  gray: 'bg-gray-800 text-gray-300',
};
---

<a
  href={`${base}/leitura/${slug}`}
  class={`block rounded-xl border p-5 transition-all hover:scale-[1.01] hover:shadow-lg ${corClasses[cor] ?? corClasses.gray} ${destaque ? 'ring-1 ring-white/10' : ''}`}
>
  <div class="flex items-start justify-between gap-3 mb-2">
    <span class={`text-xs font-medium px-2 py-0.5 rounded-full ${badgeClasses[cor] ?? badgeClasses.gray}`}>
      {nomeEstacao(dia.estacao)} · Ano {dia.ano}
    </span>
  </div>
  <h3 class="text-base font-semibold text-gray-100 leading-snug">{dia.nome}</h3>
</a>
